# Git ignore for Software Testing WGANS project

# ===== Python =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# ===== PyTorch Models =====
*.pth
*.pt
checkpoint/
models/*.pth
python/models/*.pth

# ===== Testing =====
.pytest_cache/
.coverage
htmlcov/
.tox/
.benchmarks/

# ===== IDEs =====
.vscode/
.idea/
*.swp
*.swo
*~

# ===== Maven =====
target/
.classpath
.project
.settings/
*.class

# ===== Data Files =====
# Raw data (keep structure, ignore content)
data/raw/*
!data/raw/.gitkeep
python/data/raw/*
!python/data/raw/.gitkeep

# Processed data
data/processed/*
!data/processed/.gitkeep

# Generated CSVs (except cleaned datasets)
synthetic_tests.csv
synthetic_*.csv
test_synthetic.csv
*_analysis.csv

# Keep cleaned datasets
!junit_data_cleaned.csv
!junit_data_cleaned_strict.csv

# ===== Outputs & Experiments =====
# All timestamped experiment folders
outputs/*/
python/scripts/outputs/*/
python/scripts/logs/
python/scripts/models/

# Keep only final outputs structure
!outputs/.gitkeep
!python/scripts/outputs/.gitkeep

# ===== Logs =====
logs/
python/logs/
*.log
*.err
*.out
err_*.txt
log_*.txt
run_output.txt
training_out.txt

# ===== OS =====
.DS_Store
Thumbs.db
desktop.ini

# ===== Temporary Files =====
*.tmp
*.bak
*.swp
*~.nib

# ===== EvoSuite Generated Artifacts =====
.evosuite/
evosuite-report/
evosuite-tests/

# ===== Tarefa 5: suites geradas =====
# Reescritas a cada seed por emit_junit_from_oracle.py (~1,3 MB por execucao).
# Sao produto, nao fonte: reproduzem-se com run_task5_experiment.py a partir do
# corpus e da seed. Versiona-las poluiria o historico com ruido de geracao.
src/test/java/dataloader/MathOperationsWganTests.java
src/test/java/dataloader/MathOperationsRandomTests.java
src/test/java/dataloader/MathOperationsCorpusTests.java
src/test/java/dataloader/MathOperationsKdeTests.java
